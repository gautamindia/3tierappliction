[Unit]
Description=Frontend tier application
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/app/frontend
EnvironmentFile=/opt/app/frontend/.env
ExecStart=/opt/app/frontend/venv/bin/gunicorn -w 2 -b 0.0.0.0:80 app:app
Restart=always
RestartSec=5
User=ec2-user
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
