[Unit]
Description=Backend tier application
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/app/backend
EnvironmentFile=/opt/app/backend/.env
ExecStart=/opt/app/backend/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
User=ec2-user

[Install]
WantedBy=multi-user.target
