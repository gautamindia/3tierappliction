aws_region  = "us-east-1"
project     = "threetier"
admin_cidr  = "203.0.113.4/32" # replace with your own IP/32

repo_url = "https://github.com/<your-org>/<your-repo>.git"
repo_ref = "main"

db_name     = "appdb"
db_username = "appuser"
# db_password should NOT be set here -- pass it as
#   TF_VAR_db_password=... terraform apply
# or as a GitHub Actions secret. Same for flask_secret_key.
